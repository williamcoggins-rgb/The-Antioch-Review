# The Antioch Review — Environment Variables
# These are set automatically by Vercel when you connect storage.
# Add Square and JWT variables manually in Vercel Dashboard > Settings > Environment Variables.

# JWT secret for admin authentication
JWT_SECRET=your-secret-key-here

# Vercel Postgres (auto-set when you create a Postgres database in Vercel)
# POSTGRES_URL=...
# POSTGRES_PRISMA_URL=...
# POSTGRES_URL_NON_POOLING=...

# Vercel Blob (auto-set when you create a Blob store in Vercel)
# BLOB_READ_WRITE_TOKEN=...

# Square Payment Configuration
# Get these from https://developer.squareup.com/apps
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_LOCATION_ID=your-square-location-id
SQUARE_APP_ID=your-square-application-id
SQUARE_ENV=sandbox
