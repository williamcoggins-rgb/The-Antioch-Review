{
  "installCommand": "npm install",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/faith", "destination": "/pages/category.html?cat=faith" },
    { "source": "/politics", "destination": "/pages/category.html?cat=politics" },
    { "source": "/culture", "destination": "/pages/category.html?cat=culture" },
    { "source": "/world", "destination": "/pages/category.html?cat=world" },
    { "source": "/opinion", "destination": "/pages/category.html?cat=opinion" },
    { "source": "/theology", "destination": "/pages/category.html?cat=theology" },
    { "source": "/church", "destination": "/pages/category.html?cat=church" },
    { "source": "/subscribe", "destination": "/pages/subscribe.html" },
    { "source": "/merch", "destination": "/pages/merch.html" },
    { "source": "/about", "destination": "/pages/about.html" },
    { "source": "/admin", "destination": "/pages/admin.html" },
    { "source": "/article/:slug", "destination": "/pages/article.html" }
  ]
}
